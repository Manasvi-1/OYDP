# Local development only. Never commit .env or use these example values in production.
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql://oydp_app:replace-runtime-secret@localhost:5432/oydp

# Configure a dedicated API access-token audience (never the browser ID-token audience).
# Only RS256 access tokens with typ=at+jwt are accepted. No secrets belong here.
OIDC_ISSUER=https://identity.example.invalid
OIDC_AUDIENCE=oydp-api
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json

# Set to 1 only for the loopback development issuer in tools/dev_oidc.py.
# Leave unset for any issuer that is not http://127.0.0.1 or http://localhost.
OYDP_OIDC_DEV_HTTP=

# Web workspace. SESSION_SECRET is at least 32 characters and stays off git.
# OIDC_REDIRECT_URI must match the development issuer allowlist exactly.
# PROPERTY_API_BASE is server-side; the browser does not choose it.
SESSION_SECRET=
OIDC_CLIENT_ID=oydp-web
OIDC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
PROPERTY_API_BASE=http://127.0.0.1:8000
PROPERTY_PAGE_SIZE=25
