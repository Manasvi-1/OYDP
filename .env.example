# Local development only. Never commit .env or use these example values in production.
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql://oydp_app:replace-runtime-secret@localhost:5432/oydp

# Configure a dedicated API access-token audience (never the browser ID-token audience).
# Only RS256 access tokens with typ=at+jwt are accepted. No secrets belong here.
OIDC_ISSUER=http://127.0.0.1:8080/realms/oydp
OIDC_AUDIENCE=oydp-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/oydp/protocol/openid-connect/certs

# Local Keycloak admin. Use a long random password. Do not reuse it anywhere else.
KEYCLOAK_ADMIN_USERNAME=oydp-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-local-secret

# Web sign-in. Leave these unset to keep the pasted-token form only.
# OIDC_CLIENT_ID=oydp-web
# OIDC_REDIRECT_URI=http://127.0.0.1:3000/callback
# PROPERTY_API_BASE=http://127.0.0.1:8000

# Document bytes are encrypted before they are stored. Leave this unset to fail closed.
# Generate a local 32-byte key with: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# DOCUMENT_STORAGE_KEY=
# No scanner setting is read from the environment. An absent scanner never marks a file clean.
