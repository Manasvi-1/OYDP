# Local development only. Never commit .env or use these example values in production.
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql://oydp_app:replace-runtime-secret@localhost:5432/oydp

# Configure a dedicated API access-token audience (never the browser ID-token audience).
# Only RS256 access tokens with typ=at+jwt are accepted. No secrets belong here.
# Loopback HTTP issuers require the explicit development flag below. Unset it for https.
OYDP_OIDC_DEV_HTTP=1
OIDC_ISSUER=http://127.0.0.1:8080/realms/oydp
OIDC_AUDIENCE=oydp-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/oydp/protocol/openid-connect/certs
# MFA gates require amr mfa/otp plus a fresh integer auth_time (default max age 900s).
# Set to 0 only for emergency amr-only checks, and only with OYDP_OIDC_DEV_HTTP=1.
# Production / non-dev startup rejects OYDP_MFA_MAX_AGE_SECONDS=0.
# OYDP_MFA_MAX_AGE_SECONDS=900
# Optional ACR allowlist when the IdP emits acr on access tokens (comma-separated).
# Do not enable in production until live Keycloak claim evidence shows a stable acr value.
# OYDP_MFA_ACR_VALUES=

# Interactive FastAPI /docs and /openapi.json. Default: on only with OYDP_OIDC_DEV_HTTP=1.
# Set to 1 to force-enable, 0 to force-disable.
# OYDP_ENABLE_API_DOCS=0

# Process-local mutation throttle (not distributed / not production edge protection).
# OYDP_RATE_LIMIT=1
# OYDP_RATE_LIMIT_WINDOW_SECONDS=60
# OYDP_RATE_LIMIT_MAX=120

# Local Keycloak admin. Use a long random password. Do not reuse it anywhere else.
KEYCLOAK_ADMIN_USERNAME=oydp-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-local-secret

# Web sign-in. Leave the client id and redirect unset to keep the pasted-token form only.
# The property API origin is server configuration. The browser cannot choose another origin.
# PROPERTY_API_BASE=http://127.0.0.1:8000
# OIDC_CLIENT_ID=oydp-web
# OIDC_REDIRECT_URI=http://127.0.0.1:3000/callback
#
# Authenticated session key. Generate 32 random bytes; do not commit a real value.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_KEY=

# Document bytes are encrypted before they are stored. Leave this unset to fail closed.
# Generate a local 32-byte key with: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# DOCUMENT_STORAGE_KEY=
# No scanner setting is read from the environment. An absent scanner never marks a file clean.
